{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=LivePollDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_OWN_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "LivePollApi",
    "Audience": "LivePollClient",
    "ExpiryMinutes": 60
  }
}
